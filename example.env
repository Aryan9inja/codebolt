PORT=YOUR_PORT #Port for the server to listen on, e.g., 8080
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET #Secret for verifying GitHub webhook payloads, e.g., a random string or token
GITHUB_APP_ID=YOUR_GITHUB_APP_ID #ID of your GitHub App
GITHUB_PRIVATE_KEY_PATH=YOUR_GITHUB_PRIVATE_KEY_PATH #Path in the project directory to your GitHub App's private key file, e.g., ./codebolt.pem
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY #API key for OpenRouter, e.g., sk-or-v1-...
DATABASE_URL=YOUR_DATABASE_URL #PostgreSQL connection string, e.g., postgresql://username:password@localhost:5432/dbname
GEMINI_API_KEY=YOUR_GEMINI_API_KEY #If you want to use gemini api, currently mandatory for embedding generation. Use a free one if you don't have one.